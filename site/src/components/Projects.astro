---
import { projects, STATUS_LABELS } from "../data/company";
---

<section class="section" id="projects">
  <div class="wrap">
    <p class="section__label">Projects</p>
    <h2 class="projects__heading">What I'm building</h2>
    <p class="projects__note">
      Labelled honestly. “Live” means you can use it today; anything else is
      still being built and isn't taking sign-ups yet.
    </p>

    <ul class="projects__grid">
      {projects.map((project) => (
        <li class="project">
          <div class="project__head">
            <h3 class="project__name">{project.name}</h3>
            <span class={`pill pill--${project.status}`}>
              {project.status === "live" && (
                <span class="pill__dot" aria-hidden="true"></span>
              )}
              {STATUS_LABELS[project.status]}
            </span>
          </div>

          <p class="project__tagline">{project.tagline}</p>
          <p class="project__description">{project.description}</p>

          <div class="project__foot">
            {project.url ? (
              <a class="project__link" href={project.url} rel="noopener">
                {project.urlLabel ?? "Visit"}
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.5 10h11M11 5.5l4.5 4.5L11 14.5" />
                </svg>
                <span class="visually-hidden">— {project.name}</span>
              </a>
            ) : (
              <span class="project__pending">Not public yet</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects__heading {
    max-width: 20ch;
  }

  .projects__note {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--step-sm);
  }

  .projects__grid {
    display: grid;
    gap: 1.15rem;
    margin: clamp(2.25rem, 4.5vw, 3.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 44em) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.7rem 1.6rem 1.5rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .project__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project__name {
    letter-spacing: -0.02em;
    font-size: var(--step-2);
  }

  .project__tagline {
    font-weight: 560;
    color: var(--text);
    line-height: 1.5;
  }

  .project__description {
    color: var(--text-muted);
    font-size: var(--step-sm);
    line-height: 1.62;
  }

  .project__foot {
    margin-top: 0.45rem;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step-sm);
    font-weight: 580;
    text-decoration: none;
  }

  .project__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project__link svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }

  .project__link:hover svg {
    transform: translateX(2px);
  }

  .project__pending {
    font-size: var(--step-sm);
    color: var(--text-muted);
  }

  /* Status pills */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .pill--live {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }

  .pill__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
  }
</style>
