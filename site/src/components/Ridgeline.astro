---
/**
 * Decorative ridgeline for the hero.
 *
 * Hand-authored SVG rather than a photograph or a generated image: it recolours
 * with the theme, costs no network request, stays crisp at any size, and — given
 * the position stated in the AI section — isn't generated art standing in for
 * commissioned art. See site/src/data/company.ts if you'd rather drop in a
 * commissioned illustration or your own photography.
 */
---

<div class="ridge" aria-hidden="true">
  <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" role="presentation">
    <defs>
      <linearGradient id="ridge-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--sky)" stop-opacity="0" />
        <stop offset="100%" stop-color="var(--sky)" stop-opacity="1" />
      </linearGradient>

      <!-- Conifer silhouette, baseline at the origin, growing upward. -->
      <g id="pine">
        <path
          d="M0,-30 L7.5,-15 L4,-15 L10.5,-2.5 L1.7,-2.5 L1.7,0 L-1.7,0 L-1.7,-2.5 L-10.5,-2.5 L-4,-15 L-7.5,-15 Z"
        />
      </g>
    </defs>

    <rect x="0" y="0" width="1440" height="340" fill="url(#ridge-sky)" />

    <!-- Low sun, behind everything. -->
    <circle cx="1150" cy="86" r="42" fill="var(--sun)" opacity="0.5" />

    <!-- Far ridge: three dominant summits, smaller shoulders between them. -->
    <path
      fill="var(--ridge-far)"
      d="M0,210 L120,150 L190,182 L300,88 L390,150 L470,124 L560,176 L700,110 L790,158 L880,140 L1000,196 L1120,132 L1230,170 L1340,148 L1440,182 V340 H0 Z"
    />

    <!-- Middle ridge -->
    <path
      fill="var(--ridge-mid)"
      d="M0,252 L110,214 L200,248 L310,190 L420,236 L530,206 L650,250 L760,198 L870,240 L980,216 L1100,252 L1210,204 L1320,244 L1440,218 V340 H0 Z"
    />

    <!-- Near ridge: low rolling foreground. -->
    <path
      fill="var(--ridge-near)"
      d="M0,292 L120,268 L230,296 L350,262 L470,294 L590,266 L710,298 L830,264 L950,292 L1070,266 L1190,296 L1310,268 L1440,288 V340 H0 Z"
    />

    <!-- Stands of conifers, set inboard so they survive the crop on narrow screens. -->
    <g fill="var(--ridge-tree)">
      <use href="#pine" transform="translate(396,275) scale(0.7)" />
      <use href="#pine" transform="translate(420,281) scale(0.95)" />
      <use href="#pine" transform="translate(445,288) scale(0.62)" />
      <use href="#pine" transform="translate(1100,274) scale(0.85)" />
      <use href="#pine" transform="translate(1128,281) scale(0.6)" />
    </g>
  </svg>
</div>

<style>
  .ridge {
    position: absolute;
    inset: auto 0 0 0;
    height: clamp(9rem, 20vw, 16rem);
    pointer-events: none;
    line-height: 0;
  }

  .ridge svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
