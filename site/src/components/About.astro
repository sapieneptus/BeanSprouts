---
import { about, company } from "../data/company";
---

<section class="section" id="about">
  <div class="wrap about__inner">
    <div class="about__aside">
      <div class="portrait">
        {about.portrait ? (
          <img src={about.portrait} alt={about.portraitAlt} width="600" height="600" loading="lazy" />
        ) : (
          /* Placeholder until a real photo lands — see about.portrait. */
          <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
            <circle cx="100" cy="100" r="100" fill="var(--sky)" />
            <circle cx="132" cy="66" r="26" fill="var(--sun)" opacity="0.55" />
            <path fill="var(--ridge-far)" d="M0,120 L34,96 L58,112 L88,74 L112,98 L142,80 L170,112 L200,92 V200 H0 Z" />
            <path fill="var(--ridge-mid)" d="M0,146 L30,126 L62,150 L94,118 L124,144 L156,122 L200,150 V200 H0 Z" />
            <path fill="var(--ridge-near)" d="M0,172 L38,158 L74,178 L112,156 L148,178 L182,158 L200,170 V200 H0 Z" />
          </svg>
        )}
      </div>

      <p class="section__label">{about.heading}</p>
      <h2>{company.founder.name}</h2>
    </div>

    <div class="prose about__body">
      {about.body.map((paragraph) => <p>{paragraph}</p>)}

      <p class="signature">
        <span class="signature__name">{company.founder.name}</span>
        <svg class="signature__stroke" viewBox="0 0 160 12" fill="none" aria-hidden="true">
          <path
            d="M2,8.5 C24,3.5 52,2.5 84,5 C108,6.8 130,7.4 158,4"
            stroke="var(--accent)"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <span class="signature__role">{company.name}, {company.country}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 52em) {
    .about__inner {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
      gap: 3.5rem;
    }
  }

  .about__aside {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
  }

  .portrait {
    width: clamp(8rem, 16vw, 11rem);
    aspect-ratio: 1;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .portrait img,
  .portrait svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__aside h2 {
    font-size: var(--step-2);
  }

  .about__body {
    max-width: 62ch;
  }

  .signature {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    margin-top: 1.25rem;
  }

  .signature__name {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-style: italic;
    font-size: 1.65rem;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  .signature__stroke {
    width: 8.5rem;
    height: 0.7rem;
    opacity: 0.75;
  }

  .signature__role {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
