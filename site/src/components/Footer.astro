---
import { company, nav } from "../data/company";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{company.name}</p>
      <p class="site-footer__tagline">{company.tagline}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__legal">
      <p>© {year} {company.legalName}</p>
      <p>
        CVR <span class="site-footer__cvr">{company.cvr}</span> · {company.country}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    font-size: var(--step-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 48em) {
    .site-footer__inner {
      grid-template-columns: 1fr auto auto;
      gap: 3rem;
    }
  }

  .site-footer__name {
    font-weight: 640;
    color: var(--text);
    letter-spacing: -0.015em;
  }

  .site-footer__tagline,
  .site-footer__legal p {
    color: var(--text-muted);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__legal {
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 48em) {
    .site-footer__legal {
      text-align: right;
    }
  }

  .site-footer__cvr {
    font-family: var(--font-mono);
    font-size: 0.95em;
    letter-spacing: 0.02em;
  }
</style>
