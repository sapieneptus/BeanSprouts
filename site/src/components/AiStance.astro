---
import { ai } from "../data/company";
import Contours from "./Contours.astro";

const icons = {
  yes: "M4 10.5 8 14.5 16 5.5",
  no: "M5.5 5.5 14.5 14.5 M14.5 5.5 5.5 14.5",
  line: "M3 10h14",
} as const;
---

<section class="section section--alt ai" id="ai">
  <Contours align="right" class="ai__art" />

  <div class="wrap ai__inner">
    <div class="ai__intro">
      <p class="section__label">On AI</p>
      <h2>{ai.heading}</h2>
      <p class="ai__lede">{ai.lede}</p>
    </div>

    <div class="prose ai__body">
      {ai.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <ul class="stances">
      {ai.stances.map((stance) => (
        <li class={`stance stance--${stance.verdict}`}>
          <span class="stance__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[stance.verdict]} />
            </svg>
          </span>
          <div class="stance__text">
            <p class="stance__label">{stance.label}</p>
            <h3 class="stance__title">{stance.title}</h3>
            <p class="stance__body">{stance.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="ai__closing">
      {ai.closing}{" "}
      <a href="#contact">Get in touch</a>.
    </p>
  </div>
</section>

<style>
  .ai {
    position: relative;
    overflow: hidden;
  }

  .ai__inner {
    position: relative;
    z-index: 1;
  }

  .ai__intro h2 {
    max-width: 18ch;
  }

  .ai__lede {
    margin-top: 1rem;
    max-width: 54ch;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .ai__body {
    margin-top: 1.75rem;
    font-size: var(--step-0);
  }

  .stances {
    display: grid;
    gap: 1rem;
    /* Capped so the card copy keeps a readable line length. */
    max-width: 56rem;
    margin: clamp(2.25rem, 4.5vw, 3.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .stance {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
  }

  .stance--yes {
    border-left-color: var(--accent);
  }

  .stance--line {
    border-left-color: var(--sun);
    background: color-mix(in srgb, var(--sun) 7%, var(--surface));
  }

  .stance__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    margin-top: 0.15rem;
    background: var(--bg-alt);
    color: var(--text-muted);
  }

  .stance--yes .stance__icon {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .stance--line .stance__icon {
    background: color-mix(in srgb, var(--sun) 22%, transparent);
    color: var(--sun);
  }

  .stance__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stance__label {
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .stance--yes .stance__label {
    color: var(--accent);
  }

  .stance--line .stance__label {
    color: color-mix(in srgb, var(--sun) 75%, var(--text));
  }

  .stance__title {
    letter-spacing: -0.018em;
  }

  .stance__body {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step-sm);
    line-height: 1.62;
  }

  .ai__closing {
    margin-top: 1.75rem;
    max-width: 56ch;
    font-size: var(--step-sm);
    color: var(--text-muted);
  }
</style>
