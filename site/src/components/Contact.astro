---
import { contact } from "../data/company";

const endpoint = contact.endpoint;
const hasEndpoint = endpoint.length > 0;
---

<section class="section section--alt" id="contact">
  <div class="wrap contact__inner">
    <div class="contact__intro">
      <p class="section__label">Contact</p>
      <h2>{contact.heading}</h2>
      <p class="contact__lede">{contact.lede}</p>
    </div>

    <div class="contact__panel">
      {hasEndpoint ? (
        <form id="contact-form" class="form" data-endpoint={endpoint} novalidate>
          <div class="form__row">
            <div class="field">
              <label for="cf-name">Name</label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="100"
                required
              />
              <p id="cf-name-error" class="field__error" role="alert"></p>
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
                required
              />
              <p id="cf-email-error" class="field__error" role="alert"></p>
            </div>
          </div>

          <div class="field">
            <label for="cf-topic">Topic</label>
            <select id="cf-topic" name="topic">
              <option value="general">General enquiry</option>
              <option value="product">Question about a product</option>
              <option value="bug">Bug report</option>
              <option value="idea">Idea or feature request</option>
              <option value="business">Business or partnership</option>
            </select>
          </div>

          <div class="field">
            <label for="cf-message">Message</label>
            <textarea
              id="cf-message"
              name="message"
              rows="6"
              maxlength="2000"
              required
            ></textarea>
            <p id="cf-message-error" class="field__error" role="alert"></p>
            <p id="cf-message-hint" class="field__hint">
              <span id="cf-count">0</span>/2000
            </p>
          </div>

          <!-- Honeypot: hidden from people, irresistible to naive bots. -->
          <div class="honeypot" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button id="cf-submit" class="btn btn--primary form__submit" type="submit">
            Send message
          </button>

          <p id="cf-status" class="form__status" role="status" aria-live="polite"></p>

          <p class="form__privacy">
            Your message and email go to a private issue tracker so I can keep
            track of replies. They aren't shared with anyone else, used for
            marketing, or added to a mailing list.
          </p>
        </form>
      ) : (
        <div class="form form--fallback">
          <p>
            The contact form isn't wired up in this build, so there's no way to
            reach me from this page right now. Sorry — please try again shortly.
          </p>
          <p class="form__privacy">
            To enable the form, deploy <code>workers/contact</code> and set
            <code>PUBLIC_CONTACT_ENDPOINT</code> at build time.
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    gap: 2.25rem;
    align-items: start;
  }

  @media (min-width: 54em) {
    .contact__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 3.5rem;
    }
  }

  .contact__intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .contact__lede {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 40ch;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: var(--shadow);
  }

  .form--fallback {
    gap: 0.85rem;
    color: var(--text-muted);
    font-size: var(--step-sm);
  }

  .form__row {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 30em) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--step-sm);
    font-weight: 580;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.8rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.6;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--ring);
  }

  .field :global(input[aria-invalid="true"]),
  .field :global(textarea[aria-invalid="true"]) {
    border-color: #c8442f;
  }

  .field__hint {
    justify-self: end;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .field__hint[data-state="near-limit"] {
    color: #c8442f;
  }

  /* Inline, per-field, and only rendered once there's something to say — an
     empty slot must not reserve space or the form jumps as errors appear. */
  .field__error {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #c8442f;
    margin: 0;
  }

  .field__error:empty {
    display: none;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .form__submit {
    justify-self: start;
    margin-top: 0.25rem;
  }

  .form__status {
    font-size: var(--step-sm);
    line-height: 1.55;
    margin: 0;
  }

  .form__status:empty {
    display: none;
  }

  .form__status[data-state="error"] {
    color: #c8442f;
  }

  .form__status[data-state="success"] {
    color: var(--accent);
    font-weight: 560;
  }

  .form__privacy {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin: 0;
  }

  .form__privacy code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    background: var(--bg-alt);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form) {
    const endpoint = form.dataset.endpoint ?? "";
    const submit = document.getElementById("cf-submit") as HTMLButtonElement;
    const status = document.getElementById("cf-status") as HTMLParagraphElement;
    const count = document.getElementById("cf-count") as HTMLSpanElement;
    const messageHint = document.getElementById("cf-message-hint") as HTMLElement;
    // Bots fill forms instantly; people don't. The worker rejects anything
    // submitted implausibly fast.
    const loadedAt = Date.now();

    // Kept in step with LIMITS in workers/contact/src/index.ts. The worker is
    // the authority; these exist so nobody has to round-trip to learn they
    // typed one character too few.
    const MIN_MESSAGE = 10;
    const MAX_MESSAGE = 2000;
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    interface Field {
      input: HTMLInputElement | HTMLTextAreaElement;
      error: HTMLElement;
      /** Ids that stay in aria-describedby whether or not there's an error. */
      describedBy: string[];
      validate: (value: string) => string;
      /** Errors stay hidden until the visitor leaves the field, or submits. */
      touched: boolean;
    }

    const field = (
      id: string,
      validate: (value: string) => string,
      describedBy: string[] = [],
    ): Field => ({
      input: document.getElementById(id) as HTMLInputElement,
      error: document.getElementById(`${id}-error`) as HTMLElement,
      describedBy,
      validate,
      touched: false,
    });

    const fields: Field[] = [
      field("cf-name", (value) => (value ? "" : "Please tell me your name.")),
      field("cf-email", (value) => {
        if (!value) return "Please add an email address so I can reply.";
        return EMAIL.test(value) ? "" : "That doesn't look like an email address.";
      }),
      field(
        "cf-message",
        (value) => {
          if (!value) return "Please write a message.";
          if (value.length < MIN_MESSAGE) {
            return `A little more, please — at least ${MIN_MESSAGE} characters.`;
          }
          if (value.length > MAX_MESSAGE) {
            return `That's ${value.length - MAX_MESSAGE} characters over the limit.`;
          }
          return "";
        },
        ["cf-message-hint"],
      ),
    ];

    const message = fields[2].input as HTMLTextAreaElement;

    const showError = (target: Field, error: string) => {
      target.error.textContent = error;

      const ids = error ? [...target.describedBy, target.error.id] : target.describedBy;
      if (ids.length) target.input.setAttribute("aria-describedby", ids.join(" "));
      else target.input.removeAttribute("aria-describedby");

      if (error) target.input.setAttribute("aria-invalid", "true");
      else target.input.removeAttribute("aria-invalid");
    };

    /** Returns validity; only *shows* the problem once the field is touched. */
    const check = (target: Field): boolean => {
      const error = target.validate(target.input.value.trim());
      showError(target, target.touched ? error : "");
      return !error;
    };

    for (const target of fields) {
      // Blurring a field is the visitor saying they're done with it — that's
      // the moment to speak up, not on their third keystroke.
      target.input.addEventListener("blur", () => {
        target.touched = true;
        check(target);
      });
      // Once they've been told, re-check live so the error clears the instant
      // it's fixed instead of waiting for another blur.
      target.input.addEventListener("input", () => check(target));
    }

    const updateCount = () => {
      const { length } = message.value;
      count.textContent = String(length);
      if (length >= MAX_MESSAGE * 0.9) messageHint.dataset.state = "near-limit";
      else delete messageHint.dataset.state;
    };

    message.addEventListener("input", updateCount);

    const setStatus = (text: string, state: "error" | "success" | "") => {
      status.textContent = text;
      if (state) {
        status.dataset.state = state;
      } else {
        delete status.dataset.state;
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Inline checks have usually run by now; this catches the paths that
      // skip them — Enter from the first box, or an autofilled form nobody
      // ever focused.
      let firstInvalid: Field | null = null;
      for (const target of fields) {
        target.touched = true;
        if (!check(target) && !firstInvalid) firstInvalid = target;
      }

      if (firstInvalid) {
        // The errors are sitting next to the fields; a summary line would just
        // say the same thing twice.
        setStatus("", "");
        firstInvalid.input.focus();
        return;
      }

      const data = new FormData(form);

      submit.disabled = true;
      submit.textContent = "Sending…";
      setStatus("", "");

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: String(data.get("name") ?? "").trim(),
            email: String(data.get("email") ?? "").trim(),
            topic: String(data.get("topic") ?? "general"),
            message: String(data.get("message") ?? "").trim(),
            website: String(data.get("website") ?? ""),
            elapsedMs: Date.now() - loadedAt,
          }),
        });

        if (response.ok) {
          form.reset();
          for (const target of fields) {
            target.touched = false;
            showError(target, "");
          }
          updateCount();
          setStatus(
            "Thanks — your message reached me. I'll reply to the address you gave.",
            "success",
          );
          submit.textContent = "Sent";
          return;
        }

        // Only 400 and 429 carry something the visitor can act on. Anything
        // else is a fault on my side, and its message belongs in logs, not in
        // front of someone who just wanted to send a message.
        const actionable = response.status === 400 || response.status === 429;
        const detail = actionable
          ? await response.json().catch(() => null)
          : null;
        setStatus(
          detail?.error ??
            "That didn't go through — something's wrong on my side. Please try again in a few minutes.",
          "error",
        );
      } catch {
        setStatus(
          "Couldn't reach the server. Please check your connection and try again.",
          "error",
        );
      } finally {
        if (submit.textContent !== "Sent") {
          submit.disabled = false;
          submit.textContent = "Send message";
        }
      }
    });
  }
</script>
